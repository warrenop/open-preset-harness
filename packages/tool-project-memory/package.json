{
  "name": "dsh-tool-project-memory",
  "version": "0.6.0",
  "description": "Shared project organizational memory for DeepSeek Harness — recall, remember, memory_status tools and blank-session index inject across presets",
  "type": "module",
  "main": "lib/plugin.js",
  "types": "lib/plugin.d.ts",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./core": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warrenop/open-preset-harness.git",
    "directory": "packages/tool-project-memory"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "project-memory",
    "memory",
    "agent",
    "preset"
  ]
}
